# Exemplo exclusivo para desenvolvimento local. Não usar credenciais de exemplo em produção.
API_PORT=8000
POSTGRES_PORT=5433
POSTGRES_USER=erp
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=erp

# Questão 4 — política das integrações simuladas
# Timeout máximo, em segundos, por tentativa de chamada
REQUEST_TIMEOUT=2.0
# Número total de tentativas (inclui a inicial; de 1 a 3)
MAX_ATTEMPTS=3
# Espera base em segundos; gera 0.5s e 1.0s antes dos dois retries
BACKOFF_BASE=0.5
